{
    "name": "tup-frre/laboratorio-pedidos",
    "description": "Sistema de pedidos de un laboratorio de análisis clínicos (práctica de patrones, pruebas y CI).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
